{
    "benchmark": {
        "name": "benchmark_ASR_forward",
        "description": "Ackermann Steering Robot Nonlinear system, Finite-time, Reachable, Box"
    },
    "system": {
        "type": "nonlinear_controlled",
        "dynamics": {
            "equations": [
                "u1 * cos(x3)",
                "u1 * sin(x3)",
                "u1 * tan(u2) / 0.3"
            ]
        },
        "num_inputs": 2
    },
    "initial_sets": [
        {
            "type": "box",
            "bounds": [
                [-2, 1.9],
                [-0.8, -0.7],
                [-2, 1.9],
                [-0.8, -0.7]
            ]
        }
    ],
    "domain_bounds": [
        [-10, 10],
        [-10, -10],
        [-3.141592653589793, 3.141592653589793]
    ],
    "verification": {
        "target_sets": [
            {
                "type": "box",
                "bounds": [
                    [-2, 1.9],
                    [-0.8, -0.7],
                    [-2, 1.9],
                    [-0.8, -0.7]
                ]
            }
        ],
        "time_horizon": [0.0, 1.3],
        "expected_result": "reachable"
    },
    "simulation": {
        "num_sim_trajectories": 30000,
        "start_time": 0,
        "final_time": 5,
        "time_step": 0.05
    }
}